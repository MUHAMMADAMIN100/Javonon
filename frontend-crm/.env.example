VITE_API_URL=http://localhost:3001/api

# Base URL of the public landing page. Optional, no trailing slash.
# Used for the sidebar "knowledge base" link and as an offline fallback when
# building a partner referral link (normally the link comes from the backend,
# see backend/src/common/landing-url.ts).
# Defaults to https://javonon-landing.vercel.app when unset.
VITE_LANDING_URL=https://javonon-landing.vercel.app
