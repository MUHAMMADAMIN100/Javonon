generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  // FOUNDER — основатель, единственный кто раздаёт роли,
  // имеет неявный доступ ко всему (см. RolesGuard).
  FOUNDER
  ADMIN
  ACCOUNTANT
  // Отдел продаж — работают с лидами/заявками
  SALES_MANAGER
  // Клиентский менеджер — ведут уже зачисленных студентов
  CLIENT_MANAGER
}

enum TimeEntryStatus {
  WORKING // clocked in, not on lunch
  ON_LUNCH // на обеде
  OFF // закончил день
}

// Статус одобрения причины опоздания основателем.
// Workflow: PENDING (сотрудник прислал) → APPROVED / REJECTED.
enum ExcuseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionCategory {
  TUITION_PAYMENT // оплата от студента (доход)
  ADDITIONAL_FEE // доплата (доход)
  SALARY // зарплата сотруднику (расход)
  RENT // аренда (расход)
  UTILITIES // коммуналка
  MARKETING // маркетинг
  OFFICE // офисные расходы
  MISC_EXPENSE // Доп-Расходы (мелкие/нерегулярные)
  TARGETED_ADS // Таргет-реклама (Instagram/Facebook — отличается от общего MARKETING)
  OTHER_INCOME
  OTHER_EXPENSE
}

enum SalaryStatus {
  DRAFT
  PAID
}

enum Direction {
  BACHELOR
  MASTER
  LANGUAGE
  LANGUAGE_COLLEGE
  LANGUAGE_BACHELOR
  COLLEGE
}

// Страна обучения, которую клиент выбирает в форме на лендинге.
// Заменяет собой вопрос «Ҳадаф» (direction) на лендинге, но НЕ заменяет
// сам enum Direction: Direction остаётся рабочим полем CRM (менеджер его
// правит вручную) и уже проставлен у существующих Application/Student/
// Program-строк. Postgres не умеет удалять значения enum'а, на которые
// ссылаются строки, а Railway деплоит через `prisma db push
// --accept-data-loss` — поэтому изменения только аддитивные.
enum Country {
  USA
  KOREA
  CHINA
  LATVIA
  MALAYSIA
  ITALY
  GERMANY
}

/// Статусы заявки. Значения разбиты на два блока: сначала легаси, затем
/// актуальный набор. Порядок объяснён в конце комментария — он не косметика.
///
/// АКТУАЛЬНЫЙ НАБОР (NEW_LEAD … SUCCESSFUL_LEAD) — квалификация лида. Это то,
/// что менеджер видит и выбирает в CRM, и то, что пишет весь новый код.
/// Это НЕ воронка-лестница: «Вне города» и «До 17 лет» — исходы квалификации,
/// а не этапы, поэтому UI перешёл с шагов «назад/вперёд» на плоский select.
///
/// ЛЕГАСИ (NEW … ENROLLED) — эти значения НЕЛЬЗЯ удалять или переименовывать:
///   • в проде ~496 строк Application всё ещё ссылаются на них до того, как
///     отработает prisma/migrate-lead-statuses.ts, а Postgres не умеет
///     удалять значение enum'а, на которое есть ссылки;
///   • `start:prod` выполняет `prisma db push` ДО миграционных скриптов и
///     без `--accept-data-loss` — удаление значения уронило бы деплой.
/// Ни одна поверхность UI их больше не предлагает: они остаются только для
/// того, чтобы старые строки читались, и ради совместимости на время окна
/// «деплой прошёл, миграция ещё не догнала» (см. FINISHED_APPLICATION_STATUSES
/// в src/common/application-status.ts). Отдельной уборкой их можно будет
/// выпилить, когда ни одна строка на них не ссылается.
///
/// ПОЧЕМУ ЛЕГАСИ ИДЁТ ПЕРВЫМ. Старый блок оставлен ровно таким, каким был, а
/// новые значения ДОПИСАНЫ в конец: так diff схемы получается чисто
/// аддитивным, и `prisma db push` выдаёт только
/// `ALTER TYPE "ApplicationStatus" ADD VALUE ...`. Перестановка уже
/// существующих значений заставила бы движок пересоздавать тип (drop → create),
/// а это data-loss-операция, которая на деплое упадёт. Порядок пунктов в UI
/// задаётся отдельным списком (ACTIVE_APPLICATION_STATUSES + фронтенд),
/// а не порядком строк в этом enum.
enum ApplicationStatus {
  // --- Легаси: только для чтения старых строк, в UI не предлагается ---
  NEW // legacy → NEW_LEAD
  IN_PROGRESS // legacy → IN_PROCESSING
  COMPLETED // legacy → SUCCESSFUL_LEAD
  DOCS_REVIEW // legacy → IN_PROCESSING
  DOCS_SUBMITTED // legacy → IN_PROCESSING
  PRE_ADMISSION // legacy → IN_PROCESSING
  AWAITING_PAYMENT // legacy → IN_PROCESSING
  ENROLLED // legacy → SUCCESSFUL_LEAD

  // --- Актуальный набор квалификации лида (UI-порядок 1..10) ---
  NEW_LEAD // 1  Новые лиды
  IN_PROCESSING // 2  В обработке
  ONLINE_CONSULTATION // 3  Онлайн консультации
  OFFLINE_CONSULTATION // 4  Оффлайн консультации
  THINKING // 5  Думает
  OUT_OF_TOWN // 6  Вне города
  UNDER_17 // 7  До 17 лет
  POTENTIAL_LEAD // 8  Потенциальные лиды
  LOW_QUALITY_LEAD // 9  Некачественные лиды
  SUCCESSFUL_LEAD // 10 Успешные лиды
}

enum StudentStatus {
  ACTIVE
  PAUSED
  GRADUATED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum Weekday {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

// Предпочтительный канал связи с клиентом (по ТЗ — WhatsApp / Телефон,
// плюс на будущее Instagram/Telegram/Email).
enum ContactChannel {
  WHATSAPP
  PHONE
  INSTAGRAM
  TELEGRAM
  EMAIL
}

// Onboarding-этапы для уже зачисленного студента (после оплаты).
// Используются клиентским менеджером для отслеживания прогресса
// введения студента в курс.
enum OnboardingStage {
  WELCOME // приветствие
  DOCS_COLLECTED // собраны документы
  CABINET_OPENED // открыт личный кабинет
  ACADEMY_INTRO // ознакомление с программой
  ACTIVE // в активной работе
}

model User {
  id                 String      @id @default(uuid())
  email              String      @unique
  password           String
  fullName           String
  // Основная роль — для UI/исторических проверок.
  role               Role        @default(SALES_MANAGER)
  // Дополнительные роли (один человек может быть, например, и ADMIN, и ACCOUNTANT
  // одновременно). Основатель раздаёт через POST /users/:id/roles. Проверка
  // в RolesGuard учитывает оба поля.
  roles              Role[]      @default([])
  // Для зарплатной логики: фиксированная ежемесячная ставка (или почасовая)
  baseSalary         Float?      @default(0)
  hourlyRate         Float?      @default(0)
  // Процент от продажи клиента, привязанного к этому менеджеру (бонусный %).
  // Если > 0 — перебивает тарифную сетку BonusTier (ручной override
  // для отдельных сотрудников). 0 (по умолч.) = считаем по сетке.
  bonusPercent       Float?      @default(0)
  // Множитель оплаты за переработку (overtimeMinutes × hourlyRate × multiplier).
  // По умолчанию 1.5 — стандартная мировая практика «полтора часа за час».
  overtimeMultiplier Float?      @default(1.5)
  // Кастомная роль (FOUNDER создаёт через /settings → Роли).
  // null = работает только по базовым ролям (role + roles[]).
  // Если задана — пермиссии custom-роли ДОБАВЛЯЮТСЯ к базовым.
  customRoleId       String?
  customRole         CustomRole? @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  // Доп. поля для HR-профиля (паспорт, телефон, дата приёма на работу)
  phone              String?
  passportNo         String?
  hiredAt            DateTime?
  // Цель по плану продаж в % от общего количества лидов (например 1.0 = 1%)
  kpiTargetPct       Float?      @default(1)
  // Авто-повышение KPI: каждый месяц kpiTargetPct растёт на этот шаг (% пунктов).
  // 0 = выключено. Ограничено сверху kpiMaxPct.
  kpiAutoStepPct     Float?      @default(0)
  kpiMaxPct          Float?      @default(3)
  // Активность аккаунта. false = сотрудник деактивирован (уволен/приостановлен):
  // login отклоняется, а все живые JWT перестают проходить JwtStrategy.validate
  // (см. проверку в jwt.strategy.ts). Даёт FOUNDER'у возможность немедленно
  // отобрать доступ, не удаляя User (историю сохраняем). Отдельно от delete —
  // потому что delete чревато потерей истории транзакций/задач/чата.
  isActive           Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  notifications            Notification[]
  sessions                 Session[]
  managedApplications      Application[]  @relation("ApplicationManager")
  managedChinaApplications Application[]  @relation("ApplicationChinaManager")
  managedStudents          Student[]      @relation("StudentManager")
  managedChinaStudents     Student[]      @relation("StudentChinaManager")
  // LEGACY single-assignee back-reference. Kept temporarily for backward-compat
  // (older queries/reads that expect a single assignedToId). New code uses the
  // M2M `assignedTasks` (relation "TaskAssignees") below. Drop this after all
  // callsites migrated to assignees[].
  legacyAssignedTasks      Task[]         @relation("TaskAssignee")
  // Новый M2M: список задач, где юзер стоит в assignees[].
  assignedTasks            Task[]         @relation("TaskAssignees")
  // Задачи, где юзер — контролёр (следит за выполнением, но не исполнитель).
  controlledTasks          Task[]         @relation("TaskController")
  createdTasks             Task[]         @relation("TaskCreator")

  timeEntries              TimeEntry[]
  transactionsAsManager    Transaction[]       @relation("TransactionManager")
  recordedTransactions     Transaction[]       @relation("TransactionRecorder")
  transactionsPaidVia      Transaction[]       @relation("TransactionPaidVia")
  salaryRecords            SalaryRecord[]
  dailyReports             DailyReport[]
  chatMessages             ChatMessage[]       @relation("ChatMessageAuthor")
  chatReactions            ChatReaction[]      @relation("ChatReactionUser")
  chatMemberships          ChatMember[]
  authoredCourses          Course[]            @relation("CourseAuthor")
  interactionsAuthored     Interaction[]       @relation("InteractionAuthor")
  penalties                Penalty[]
  paymentsConfirmed        Payment[]           @relation("PaymentConfirmedBy")
  documents                UserDocument[]
  accessGrantsReceived     DataAccessGrant[]   @relation("AccessGrantee")
  accessGrantsToMe         DataAccessGrant[]   @relation("AccessTarget")
  callLogs                 CallLog[]           @relation("CallLogUser")
  offerSignatures          OfferSignature[]
  workSchedules            WorkSchedule[]
  submissions              SaleSubmission[]    @relation("SubmissionManager")
  submissionPaymentReviews SubmissionPayment[] @relation("SubmissionPaymentReviewer")
  // Позиции внутри buckets схемы распределения выручки. При удалении
  // сотрудника ссылка обнуляется (SetNull) — «место» в схеме остаётся,
  // FOUNDER решает, кого туда поставить.
  revenueBucketItems       RevenueBucketItem[] @relation("RevenueBucketItemUser")

  // Расписание: группы, где сотрудник — штатный преподаватель, и отдельные
  // занятия, которые он ведёт на замене. Обе связи SetNull — увольнение
  // сотрудника не уносит ни группу, ни историю занятий.
  taughtGroups   StudyGroup[]   @relation("StudyGroupTeacher")
  taughtSessions ClassSession[] @relation("ClassSessionTeacher")
}

// ============================================================
// SESSIONS — серверная таблица сессий сотрудников для отзыва JWT.
// ============================================================
// Каждый успешный /auth/login создаёт row; в JWT кладётся payload.sid = Session.id.
// JwtStrategy.validate проверяет что сессия существует и revokedAt IS NULL,
// иначе токен отклоняется. Без этой модели уволенный сотрудник продолжал бы
// иметь доступ до истечения JWT (до 30 дней), даже после удаления User row.
//
// FOUNDER может отозвать любую сессию (POST /auth/sessions/:id/revoke),
// сотрудник — свою собственную (POST /auth/logout).
model Session {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  // NULL = активна. Non-null = отозвана (login/logout/принудительно FOUNDER'ом).
  revokedAt DateTime?
  userAgent String?
  ip        String?

  @@index([userId, revokedAt])
  @@index([revokedAt])
}

// Документы сотрудника (паспорт, контракт, дипломы и т.п.). По
// аналогии со студенческими Document. Cascade-delete при удалении User.
enum UserDocumentType {
  PASSPORT
  PHOTO // фото для профиля/HR
  CONTRACT
  DIPLOMA
  OFFER // подписанная копия оферты (если сохраняем PDF)
  OTHER
}

// Оферта — текст соглашения, который сотрудник должен прочитать и
// подписать онлайн при первом входе. Хранится отдельной моделью, чтобы
// админ мог редактировать и versionировать. В системе допустима только
// ОДНА isActive=true оферта; новая запись со сменой текста создаёт
// новую версию и автоматически делает старую неактивной.
model OfferTemplate {
  id        String   @id @default(uuid())
  title     String   @default("Оферта сотрудника")
  content   String // markdown / plain text
  version   Int      @default(1)
  isActive  Boolean  @default(true)
  // Для какой роли эта оферта. null = «общая» (legacy fallback,
  // показывается тем, для чьей роли нет специальной).
  role      Role?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  signatures OfferSignature[]

  @@index([isActive])
  @@index([role, isActive])
}

// Подпись оферты конкретным сотрудником. После создания запись не
// меняется — это аудит-лог согласия. Уникальная пара (userId, offerId)
// — повторно подписать ту же версию нельзя.
model OfferSignature {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  offerId   String
  offer     OfferTemplate @relation(fields: [offerId], references: [id], onDelete: Cascade)
  signedAt  DateTime      @default(now())
  ip        String?
  userAgent String?

  @@unique([userId, offerId])
  @@index([userId])
}

model UserDocument {
  id           String           @id @default(uuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         UserDocumentType
  url          String
  originalName String?
  size         Int?
  comment      String?
  createdAt    DateTime         @default(now())

  @@index([userId, type])
}

// Заявка на обучение: создаётся через лендинг (POST /applications/public),
// либо автоматически вместе со студентом из CRM ("+ Студент").
// При удалении любого из связанных объектов (User-менеджер, Program) заявка
// остаётся в БД с обнулённой ссылкой (SetNull) — историю не теряем.
// При удалении Student — Application НЕ удаляется автоматически
// (нет onDelete: Cascade на student-связи), поэтому в applications.service.remove()
// студент явно удаляется отдельно.
enum ApplicationSource {
  LANDING_FORM
  SELF_REGISTRATION
  REFERRAL
  INSTAGRAM
  TELEGRAM
  GOOGLE_ADS
  TIKTOK
  WORD_OF_MOUTH
  EVENT
  OTHER
}

model Application {
  id                    String            @id @default(uuid())
  fullName              String
  phone                 String
  // Доп. телефон (мать/отец/контактное лицо) — по ТЗ.
  secondaryPhone        String?
  // Подпись доп. контакта: "Отец", "Мать" и т.п.
  secondaryContactLabel String?
  email                 String?
  // Предпочтительный канал связи с клиентом.
  preferredChannel      ContactChannel?
  // Направление обучения. Лендинг его БОЛЬШЕ НЕ СПРАШИВАЕТ (вместо него
  // теперь спрашивается country), но поле остаётся обязательным:
  //  • на него ссылаются существующие строки Application/Student/Program,
  //    ~30 файлов бэкенда и ~10 страниц CRM (фильтры, дашборд, массрассылки,
  //    подбор программ, отчёты);
  //  • Postgres не может удалить значение enum'а, пока на него есть ссылки,
  //    а Railway на деплое гоняет `prisma db push --accept-data-loss`.
  // При создании заявки с лендинга сервис подставляет плейсхолдер
  // (Direction.BACHELOR), который менеджер правит в CRM.
  direction             Direction
  // Отличает ОТВЕТ от ПЛЕЙСХОЛДЕРА в колонке direction выше.
  //   true  — направление реально прислали: CRM (StudentsService.create),
  //           самозапись (StudentAuthService.register), approve заявки
  //           партнёра (SubmissionsService) — все они пишут Application
  //           напрямую через Prisma, — либо менеджер подтвердил его руками
  //           через PATCH /applications/:id. Telegram-бота в этом списке
  //           нет: он заявок не создаёт вообще (bot-funnel.service.ts);
  //   false — в direction лежит DEFAULT_DIRECTION, поставленный только
  //           чтобы удовлетворить NOT NULL. Такие строки исключаются из
  //           агрегата «по направлениям» на дашборде и из фильтра списка,
  //           иначе 100% лидов с лендинга считались бы «Бакалавриатом».
  // @default(true): все строки, существовавшие до этой колонки, создавались
  // формой, которая направление ЕЩЁ спрашивала — там это настоящий ответ.
  directionConfirmed    Boolean           @default(true)
  // Страна, которую клиент реально выбрал в форме лендинга. Nullable:
  // у всех заявок, созданных до этого изменения, её нет.
  country               Country?
  // WhatsApp-номер. На лендинге по умолчанию совпадает с phone
  // (чекбокс «Ҳамон рақами телефон» включён), но клиент может указать другой.
  // Нормализуется так же, как phone (trim).
  whatsappPhone         String?
  // Дата рождения из формы лендинга. При конвертации заявки в Student
  // копируется в Student.birthday → начинает работать cron birthdayGreetings.
  // КОНВЕНЦИЯ: календарный день хранится UTC-полуночью («2006-03-12T00:00:00Z»),
  // писать только через parseCalendarDateUtc() (src/common/tj-time.ts).
  // Душанбинская полночь здесь ломает cron: он читает EXTRACT(DAY FROM birthday)
  // по сырой UTC-колонке и получил бы предыдущие сутки.
  birthday              DateTime?
  comment               String?
  source                ApplicationSource @default(LANDING_FORM)
  status                ApplicationStatus @default(NEW)
  // За заявкой числится долг («ждёт оплаты») — источник правды для
  // раздела «Задолженность студентов» (GET /finance/pending-payments,
  // карточка «Студентов с задолженностью» на дашборде).
  //
  // ПОЧЕМУ ОТДЕЛЬНАЯ КОЛОНКА, А НЕ СТАТУС. Долг раньше выражался статусом
  // ApplicationStatus.AWAITING_PAYMENT. Новый набор статусов — это исходы
  // квалификации лида, «ожидает оплаты» среди них нет, а
  // prisma/migrate-lead-statuses.ts схлопывает AWAITING_PAYMENT в
  // IN_PROCESSING вместе с остальной старой воронкой. Оставить чтение
  // финансов на статусе значило бы после миграции навсегда получить пустой
  // список должников — причём молча, «ноль долгов» вместо ошибки.
  // Поэтому признак вынесен в durable-колонку: миграция его ЗАПОЛНЯЕТ
  // (backfill из AWAITING_PAYMENT) ДО того, как перезапишет статусы, а
  // менеджер продолжает ставить/снимать его руками в карточке заявки —
  // независимо от того, на каком статусе квалификации сейчас лид.
  //
  // @default(false) — все строки, существовавшие до колонки, получают false,
  // и настоящих должников среди них восстанавливает backfill миграции.
  paymentPending        Boolean           @default(false)
  studentId             String?
  // student → SetNull-семантика по сути не задана, потому что removed применяется в коде вручную.
  student               Student?          @relation(fields: [studentId], references: [id])
  managerId             String?
  // Удалили сотрудника-менеджера TJ → менеджер у заявки обнуляется, заявка остаётся.
  manager               User?             @relation("ApplicationManager", fields: [managerId], references: [id], onDelete: SetNull)
  chinaManagerId        String?
  // Аналогично для китайского менеджера.
  chinaManager          User?             @relation("ApplicationChinaManager", fields: [chinaManagerId], references: [id], onDelete: SetNull)
  programId             String?
  // Удалили программу → у заявки programId становится null.
  program               Program?          @relation(fields: [programId], references: [id], onDelete: SetNull)
  // Воронка продаж (Pipeline) + текущий этап воронки. Это «параллельное»
  // отслеживание поверх ApplicationStatus enum — статус остаётся
  // высокоуровневым бакетом (NEW/DOCS_REVIEW/...), а pipelineStageId —
  // тонкий настраиваемый шаг внутри выбранной воронки.
  pipelineId            String?
  pipeline              Pipeline?         @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  pipelineStageId       String?
  pipelineStage         PipelineStage?    @relation(fields: [pipelineStageId], references: [id], onDelete: SetNull)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  submission SaleSubmission? @relation("SubmissionApplication")
  // Сделки, ЗАВЕДЁННЫЕ из этой заявки (обратная сторона
  // SaleSubmission.sourceApplicationId). Список, а не одна запись: отменённая
  // сделка остаётся в истории, а по тому же лиду заводят новую.
  sourcedSubmissions SaleSubmission[] @relation("SubmissionSourceApplication")

  @@index([status])
  @@index([direction])
  // Финансы читают только должников (paymentPending = true) — их единицы
  // на фоне всей таблицы, без индекса это seq scan на каждом открытии
  // дашборда.
  @@index([paymentPending])
  // CRM фильтрует список заявок по стране (тулбар «Кишвар»/«Страна»).
  @@index([country])
  @@index([managerId])
  @@index([chinaManagerId])
  @@index([programId])
}

model Student {
  id               String          @id @default(uuid())
  fullName         String
  // День рождения — для авто-поздравления (cron birthdayGreetings).
  // Та же конвенция, что у Application.birthday: UTC-полночь календарного дня
  // (parseCalendarDateUtc). Смесь двух смещений в этой колонке = поздравления
  // части студентов на сутки раньше; исторические строки чинит
  // prisma/migrate-birthdays-utc.ts.
  birthday         DateTime?
  // Все телефоны: phones[0] — основной, phones[1+] — дополнительные.
  phones           String[]        @default([])
  // Подписи к phones: ["сам", "Отец", "Мать"]. Длина может отличаться
  // от phones — недостающие позиции считаются пустыми.
  phoneLabels      String[]        @default([])
  // Предпочтительный канал связи (ТЗ: WhatsApp / Телефон).
  preferredChannel ContactChannel?
  // QA-fix #43: уникальный email — параллельные регистрации создавали N дублей,
  // forgot-password/login находили только первого через findFirst.
  // Multiple null-email'ов разрешены (Prisma allows multiple NULLs).
  email            String?         @unique
  password         String?
  /// Версия токена для инвалидации старых JWT после смены пароля.
  /// Инкрементируется в regeneratePassword/changePassword. Старые токены
  /// (с прежним tokenVersion) отбрасываются StudentJwtStrategy. Без этого
  /// после reset пароля старый JWT жил ещё 7 дней — sec audit fix.
  tokenVersion     Int             @default(0)
  applicationForm  Json?
  photoUrl         String?
  direction        Direction
  // Тот же смысл, что у Application.directionConfirmed:
  //   true  — направление выбрал живой человек (менеджер в CRM, самозапись,
  //           одобрение заявки партнёра);
  //   false — направление скопировано из заявки-лендинга, где оно всего лишь
  //           плейсхолдер (DEFAULT_DIRECTION). Пока флаг false, cabinet ниже —
  //           это DEFAULT_CABINET-«приёмник», а НЕ результат маршрутизации
  //           по направлению, и карточка студента показывает «не подтверждено»
  //           вместо выдуманного «Бакалавриата».
  // @default(true): все строки, существовавшие до этой колонки, заводились
  // через CRM/самозапись с настоящим направлением.
  directionConfirmed Boolean       @default(true)
  cabinet          Int
  // Страна, выбранная клиентом в форме лендинга («Кишвар»), перенесённая
  // при конвертации заявки. Без неё единственный НАСТОЯЩИЙ ответ клиента
  // о его цели не переживал бы конвертацию: в карточке студента остался бы
  // только placeholder-direction, и менеджеру пришлось бы возвращаться
  // в исходную Application. Nullable — у студентов, заведённых вручную
  // и созданных до этой колонки, страны нет.
  country          Country?
  status           StudentStatus   @default(ACTIVE)
  onboardingStage  OnboardingStage @default(WELCOME)
  comment          String?
  managerId        String?
  manager          User?           @relation("StudentManager", fields: [managerId], references: [id], onDelete: SetNull)
  chinaManagerId   String?
  chinaManager     User?           @relation("StudentChinaManager", fields: [chinaManagerId], references: [id], onDelete: SetNull)
  programId        String?
  program          Program?        @relation(fields: [programId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  documents      Document[]
  applications   Application[]
  transactions   Transaction[]
  enrollments    Enrollment[]
  lessonProgress LessonProgress[]
  interactions   Interaction[]
  payments       Payment[]
  callLogs       CallLog[]        @relation("CallLogStudent")
  submissions    SaleSubmission[] @relation("StudentSubmissions")

  // Членство в учебных группах — единственный путь студента к расписанию.
  groupMemberships GroupMember[] @relation("StudentGroupMemberships")

  @@index([direction])
  @@index([cabinet])
  @@index([status])
  @@index([managerId])
  @@index([chinaManagerId])
  @@index([programId])
}

// Документ студента (10 типов + OTHER).
// При удалении студента документы каскадно удаляются (Cascade) — это сейчас
// единственная Cascade-связь в схеме. Заявки и менеджеры используют SetNull.
model Document {
  id           String   @id @default(uuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  type         String   @default("OTHER")
  createdAt    DateTime @default(now())

  @@index([studentId, type])
}

model Task {
  id                   String     @id @default(uuid())
  title                String
  description          String
  status               TaskStatus @default(TODO)
  // Дедлайн задачи (ТЗ §3.7). Null = без дедлайна.
  deadline             DateTime?
  // Cron уже отправил напоминание (за 24ч до дедлайна) — чтобы не спамить.
  deadlineReminderSent Boolean    @default(false)
  // Cron уже отправил уведомление о просрочке.
  overdueNotified      Boolean    @default(false)
  // LEGACY: одиночный исполнитель. Сделан nullable + onDelete SetNull, чтобы
  // миграция была не деструктивной (данные не теряются при удалении юзера,
  // старые задачи с одним исполнителем продолжают работать). Новый код
  // должен писать в assignees[] (M2M). Значение assignedToId продолжаем
  // держать как «первый ассайни» для обратной совместимости с UI/queries,
  // ожидающими одиночное поле. Дропнем в отдельной миграции позже.
  assignedToId         String?
  assignedTo           User?      @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  // Новый M2M: несколько исполнителей на одну задачу. Prisma создаст
  // неявную junction-таблицу _TaskAssignees(A=Task.id, B=User.id).
  assignees            User[]     @relation("TaskAssignees")
  // Контролёр — наблюдатель за задачей (может быть FOUNDER/руководитель отдела).
  // Не исполнитель; получает уведомления о статусе, не считается в KPI-нагрузке.
  controllerId         String?
  controller           User?      @relation("TaskController", fields: [controllerId], references: [id], onDelete: SetNull)
  createdById          String?
  createdBy            User?      @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@index([assignedToId])
  @@index([controllerId])
  @@index([status])
  @@index([deadline])
}

model Program {
  id                   String    @id @default(uuid())
  name                 String
  university           String
  city                 String
  major                String
  direction            Direction
  cost                 Float
  currency             String    @default("CNY")
  duration             String?
  language             String?
  description          String?
  imageUrl             String?
  /// Дополнительные фото программы для галереи (до 5-7 шт., ТЗ-доработка п.4).
  /// imageUrl остаётся как primary (обложка); imageUrls — все, включая её.
  imageUrls            String[]  @default([])
  /// Академические направления / специальности тегами (ТЗ-доработка п.6).
  /// Например ["Machine Learning", "Data Science", "Computer Vision"].
  disciplines          String[]  @default([])
  /// Страна (для группировки/фильтра на странице программ, ТЗ-доработка п.9).
  /// Отдельно от city — у одного университета может быть несколько кампусов.
  country              String?
  /// Ссылка на официальный сайт университета (ТЗ-доработка).
  /// На карточке/детальной показывается кнопкой «🌐 Официальный сайт».
  universityWebsiteUrl String?
  published            Boolean   @default(true)
  telegramMessageId    Int?
  telegramHasPhoto     Boolean   @default(false)

  // === Расширенные поля для каталога (требование доработок) ===
  // Требуемый уровень английского (IELTS 6.0 / HSK 4 / без требований и т.п.)
  englishLevel        String?
  // Есть ли грант/стипендия
  hasGrant            Boolean @default(false)
  // Что покрывает грант (обучение / проживание / стипендия) — свободный текст
  grantDetails        String?
  // Уровень английского для получения гранта (если отличается)
  grantEnglishLevel   String?
  // Средний проходной балл (текст — может быть GPA, % или баллы)
  avgAdmissionScore   String?
  // Окно подачи документов / дедлайны
  applicationDeadline String?
  // Сколько раз в год можно подавать (intakes)
  intakesPerYear      Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications Application[]
  students     Student[]
  scholarships ProgramScholarship[]
  documents    ProgramDocument[]
  comments     ProgramComment[]
  submissions  SaleSubmission[]     @relation("ProgramSubmissions")

  // Учебные группы, занимающиеся по этой программе (см. StudyGroup).
  studyGroups       StudyGroup[]              @relation("ProgramStudyGroups")
  // Шаблон рассрочки: этапы, из которых материализуются PaymentStage сделки.
  installmentStages ProgramInstallmentStage[]

  @@index([city])
  @@index([country])
  @@index([major])
  @@index([direction])
  @@index([published])
}

/// Документы программы (ТЗ-доработка п.7): syllabus, requirements,
/// admission_guide и т.п. Загружаются админом, видны на детальной
/// странице как ссылки на скачивание.
model ProgramDocument {
  id           String   @id @default(uuid())
  programId    String
  program      Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  name         String // отображаемое название
  url          String // /uploads/...
  size         Int? // байты, опц.
  uploadedById String? // FK не делаем — историю не теряем при удалении юзера
  createdAt    DateTime @default(now())

  @@index([programId])
}

/// Внутренние комментарии админов к программе (ТЗ-доработка п.7).
/// Видны только сотрудникам (CRM), не показываются на лендинге.
model ProgramComment {
  id         String   @id @default(uuid())
  programId  String
  program    Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  authorId   String // FK не делаем для сохранения истории
  authorName String // снэпшот имени на момент создания
  text       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([programId, createdAt])
}

/// Стипендия / грант для программы (ТЗ-доработка п.10).
/// Раньше был один чекбокс hasGrant + текст grantDetails — этого
/// мало. Теперь у программы N стипендий, каждая со своими полями:
/// сумма покрытия, что включено, требования, дедлайн, ссылка.
model ProgramScholarship {
  id           String   @id @default(uuid())
  programId    String
  program      Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  name         String // "CSC Scholarship"
  coverage     String? // "Полное" / "Частичное"
  amount       String? // "5 000 USD в год" — свободный текст
  includes     String? // "Обучение, проживание, питание"
  requirements String? // "GPA 3.5+, IELTS 6.0"
  deadline     String? // "1 марта" — свободный текст
  link         String? // https://...
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([programId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // "APPLICATION_NEW", "APPLICATION_DELAY", etc.
  title     String
  message   String
  payload   Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([createdAt])
}

model ActivityLog {
  id          String   @id @default(uuid())
  actorId     String?
  actorName   String
  actorRole   String // ADMIN | EMPLOYEE
  action      String // "STATUS_CHANGE" | "STUDENT_UPDATE" | "MANAGER_CHANGE" | "STUDENT_CREATE" | "STUDENT_DELETE"
  studentId   String?
  studentName String?
  details     String // human-readable: "Статус: NEW → DOCS_REVIEW", "Менеджер TJ: A → B"
  payload     Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([studentId])
  @@index([actorId])
}

// ============================================================
// HR / Time tracking
// ============================================================
// Один TimeEntry — одна рабочая сессия (день).
// При нажатии "Начал работу" создаётся новая запись со статусом WORKING.
// "Ушёл на обед" → ON_LUNCH (lunchOut установлен).
// "Вернулся" → WORKING (lunchIn установлен, totalLunchMinutes пересчитан).
// "Закончил день" → OFF (clockOut установлен, totalMinutes пересчитан).
model TimeEntry {
  id                        String          @id @default(uuid())
  userId                    String
  user                      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  status                    TimeEntryStatus @default(WORKING)
  clockIn                   DateTime
  lunchOut                  DateTime?
  lunchIn                   DateTime?
  clockOut                  DateTime?
  // Кэш отработанных минут — пересчитывается при clockOut
  totalMinutes              Int             @default(0)
  totalLunchMinutes         Int             @default(0)
  // Опоздание относительно нормы (в минутах). Расчёт: clockIn - 09:00.
  lateMinutes               Int             @default(0)
  // Опоздание после обеда (lunchIn - scheduled lunch end). Штраф
  // считается отдельно по той же шкале PenaltyRule.
  lateLunchMinutes          Int             @default(0)
  // Признак, что штраф за позднее возвращение с обеда уже начислен
  // (penalty record создан). Чтобы повторно не начислять при пересчёте.
  lateLunchPenaltyApplied   Boolean         @default(false)
  // Объяснение позднего возвращения с обеда (по аналогии с lateExcuse*).
  // Сотрудник пишет причину в модалке при lunchIn если опоздание > порога.
  // FOUNDER одобряет/отклоняет — APPROVED отменяет штраф.
  lunchLateExcuseUrl        String?
  lunchLateExcuseReason     String?
  lunchLateExcuseAt         DateTime?
  lunchLateExcuseStatus     ExcuseStatus?
  lunchLateExcuseReviewedAt DateTime?
  lunchLateExcuseReviewedBy String?
  // Переработка: всё что отработано сверх 8 часов (480 мин)
  overtimeMinutes           Int             @default(0)
  // Подтверждение присутствия на работе (геолокация / видео-кружок).
  // Хотя бы одно должно быть заполнено при clock-in.
  clockInLat                Float?
  clockInLon                Float?
  clockInProofUrl           String? // video/photo URL
  // Объяснение опоздания (если lateMinutes > порог). Если пусто
  // и опоздание сверх порога — Cron начислит штраф.
  lateExcuseUrl             String?
  lateExcuseReason          String?
  lateExcuseAt              DateTime?
  // Статус причины опоздания (требует одобрения основателя по ТЗ).
  // PENDING — ждёт одобрения. APPROVED — основатель одобрил, штраф
  // не списывается / уже отменён. REJECTED — отклонил, штраф остаётся.
  // null — причина не прислана, обычное опоздание.
  lateExcuseStatus          ExcuseStatus?
  lateExcuseReviewedAt      DateTime?
  lateExcuseReviewedBy      String?
  // Помечается true когда Cron уже создал штраф за это опоздание
  // (защита от дублей при перезапуске Cron).
  latePenaltyApplied        Boolean         @default(false)
  date                      DateTime        @default(now()) @db.Date // дата сессии для удобной группировки
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  @@index([userId, date])
  @@index([status])
}

// ============================================================
// FINANCE — доходы и расходы
// ============================================================
// Каждая транзакция привязана:
//  - INCOME (TUITION_PAYMENT/ADDITIONAL_FEE) → к Student (студент-плательщик)
//                                            + опционально к manager (для бонуса)
//  - EXPENSE (SALARY) → к recipient User (получатель зарплаты)
//  - EXPENSE (RENT/UTILITIES/...) → без связи, только category
//
// recordedById — кто внёс транзакцию (бухгалтер или админ).
// Способ оплаты (для расширенной финансовой записи)
enum PaymentChannel {
  ALIF_MOBILE // АлифМобайл
  CASH // наличные
  BANK_TRANSFER // банковский перевод
  CARD // картой
  CRYPTO // криптовалюта
  OTHER
}

// Тип оплаты: полная или предоплата (для входящих доходов)
enum PaymentKind {
  FULL
  PREPAYMENT
  ADDITIONAL // доплата по старому клиенту
  OWNER_INVESTMENT // вложение собственника в компанию (не от клиента)
}

// Подтверждение расхода (для исходящих)
enum ReceiptKind {
  RECEIPT // обычный чек/счёт-фактура
  CASH_PHOTO // фотография наличных (вместо чека)
  REASON_ONLY // только причина (без фото) — допустимо в редких случаях
}

// Источник дохода (для INCOME): новый клиент vs апселл существующему vs прочее
enum IncomeSource {
  NEW_CLIENT // Новый клиент — с нуля закрыл впервые
  UP_SALE // Апселл существующему клиенту
  OTHER // Прочее / неопределённо
}

// Продуктовая категория (enum-версия productCategory) для Google Sheet-parity
enum ProductCategory {
  CONTRACT // Основной контракт по программе (обучение за рубежом)
  MASTERCLASS // Мастер-класс
  ACADEMY // Академия (языковой курс/подготовка)
  OTHER // Другое
}

// Фаза оплаты дохода: предоплата vs полная
enum PaymentPhaseStatus {
  PREPAID // Перед оплата (предоплата)
  FULL // Полная оплата
}

model Transaction {
  id       String              @id @default(uuid())
  type     TransactionType
  category TransactionCategory
  amount   Float
  currency String              @default("TJS")
  comment  String?
  date     DateTime            @default(now())

  studentId    String?
  student      Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  managerId    String?
  manager      User?    @relation("TransactionManager", fields: [managerId], references: [id], onDelete: SetNull)
  recordedById String?
  recordedBy   User?    @relation("TransactionRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  // === Расширения для финансового модуля ===
  // Способ оплаты — Алиф / наличные / банк / карта / крипто
  paymentChannel  PaymentChannel?
  // Полная / предоплата / доплата / вложение (только для INCOME)
  paymentKind     PaymentKind?
  // Продуктовая категория дохода — Академия / Канада / США / Языковые
  // и т.п. Свободный текст т.к. список продуктов меняется.
  // LEGACY: НЕ канонический источник — существует только для обратной
  // совместимости со старыми клиентами и для `incomeByProduct` (группирует
  // по этому полю). Канонический источник — `productCategoryEnum` ниже;
  // FinanceService.create/update поддерживают zeркальную синхронизацию
  // (enum → метка в этот String; String с известной меткой → enum).
  productCategory String?
  // ФИО плательщика (если отличается от студента — например, родитель)
  payerName       String?
  // Чек / подтверждение (URL загруженной фотки)
  receiptUrl      String?
  receiptKind     ReceiptKind?
  // Причина отсутствия чека (если receiptKind = REASON_ONLY)
  noReceiptReason String?

  // === Google Sheet parity ===
  // Источник дохода (только для type=INCOME): новый клиент / апселл / прочее
  incomeSource        IncomeSource?
  // Enum-версия productCategory (существующее String-поле сохраняется для
  // обратной совместимости со старыми записями; новые пишут сюда).
  productCategoryEnum ProductCategory?
  // Фаза оплаты (только для type=INCOME): предоплата или полная
  paymentPhase        PaymentPhaseStatus?
  // Через чью карту прошёл расход (для type=EXPENSE)
  paidViaId           String?
  paidVia             User?               @relation("TransactionPaidVia", fields: [paidViaId], references: [id], onDelete: SetNull)

  // Метка для бонусной системы: уже учтена в SalaryRecord ?
  bonusApplied Boolean @default(false)

  // Soft-delete для возвратов / отменённых сделок (bug #25 из audit:edge-cases).
  // Когда SaleSubmission переходит в CANCELLED, оригинальная INCOME-транзакция
  // помечается reversedAt=now() (для аудит-трейла остаётся, но исключается
  // из salesAmount-агрегации в salary/kpi); параллельно создаётся обратная
  // EXPENSE-транзакция (OTHER_EXPENSE) — чтобы finance dashboard (доход − расход)
  // отражал реальный нетто.
  reversedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, category])
  @@index([date])
  @@index([studentId])
  @@index([managerId])
  @@index([paidViaId])
  @@index([reversedAt])
}

// ============================================================
// SALARY — расчёт зарплаты сотрудника за период
// ============================================================
// SalaryRecord = расчёт за конкретный месяц для конкретного сотрудника.
// totalHours/totalMinutes собираются из TimeEntry за период.
// salesAmount/bonusAmount — сумма продаж клиентов этого менеджера в периоде × bonusPercent.
// kpiBonus — ручной бонус, который проставляет ADMIN.
// netAmount = baseSalary + bonusAmount + kpiBonus.
model SalaryRecord {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  periodStart DateTime
  periodEnd   DateTime

  workedMinutes   Int    @default(0) // отработано за период
  lateMinutes     Int    @default(0) // суммарное опоздание
  overtimeMinutes Int    @default(0) // суммарная переработка (ТЗ-доработка)
  baseAmount      Float  @default(0) // базовая ставка за период
  salesAmount     Float  @default(0) // сумма продаж клиентов менеджера
  bonusAmount     Float  @default(0) // baseSalesAmount × bonusPercent
  overtimePay     Float  @default(0) // оплата переработки (ТЗ-доработка)
  kpiBonus        Float  @default(0) // ручной бонус
  penalties       Float  @default(0) // штрафы (за опоздания и т.п.)
  netAmount       Float  @default(0) // итог к выплате
  currency        String @default("TJS")

  // ── СНИМОК РАСШИФРОВКИ КОМИССИИ на момент создания записи ──
  // Зачем: bonusAmount сам по себе не объясним. Правило комиссии —
  // flat-по-полосе от МЕСЯЧНОГО объёма (common/bonus-bands.ts), минус уже
  // начисленное другими записями того же месяца. Через полгода, в споре
  // «почему тут 12 500», ни объём, ни полосу, ни вычет восстановить нечем:
  // сетка живёт в коде и может смениться, платежи могли быть отменены,
  // пересчёт дал бы уже другое число. Поэтому сохраняем ровно те цифры,
  // из которых bonusAmount и получился.
  //
  // ВСЕ ПОЛЯ NULLABLE НАМЕРЕННО: записи, созданные до этого изменения,
  // остаются с NULL и НЕ пересчитываются. NULL значит «снимка нет», а не
  // «ноль» — CRM в этом случае просто не рисует расшифровку.
  // ПРИЗНАК НАЛИЧИЯ СНИМКА — bonusBandKey != null (а не bonusBandMax:
  // у верхней полосы потолка нет, там NULL — легальное значение).
  bonusVolume      Float?  // объём продаж за календарный месяц (TJS)
  bonusBandKey     String? // ключ полосы (band1…band5) на момент расчёта
  bonusBandMin     Float?  // нижняя граница полосы, включительно
  bonusBandMax     Float?  // верхняя граница полосы, включительно; NULL = без потолка
  bonusPercent     Float?  // ставка, применённая ко ВСЕМУ объёму
  bonusMonthTotal  Float?  // комиссия за месяц целиком, до вычета уже начисленного
  bonusAlreadyPaid Float?  // уже начислено за этот месяц другими записями
  bonusSource      String? // 'BAND' — ставка из сетки; 'PERSONAL' — процент сотрудника

  status  SalaryStatus @default(DRAFT)
  paidAt  DateTime?
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // БД-гард от двойного начисления. Бонус менеджера считается за
  // КАЛЕНДАРНЫЙ МЕСЯЦ, а из месячной комиссии вычитается сумма
  // bonusAmount записей того же месяца (см. salary.service.ts). Эта
  // проверка — read-then-write: два одновременных POST /salary за один
  // период (двойной клик по «Зафиксировать», ретрай запроса) оба видели
  // bonusAlreadyPaid = 0 и оба писали ПОЛНУЮ месячную комиссию, а
  // markPaid резал под них две отдельные SALARY-расходные транзакции.
  // Прикладной код теперь делает агрегат и вставку одной SERIALIZABLE
  // транзакцией, а этот уникальный индекс — второй рубеж: две зарплатные
  // строки на одного сотрудника с одинаковым periodStart физически
  // невозможны. Несколько записей ВНУТРИ месяца (аванс + окончательный
  // расчёт) по-прежнему разрешены — у них разный periodStart.
  //
  // Индекс заменяет прежний @@index([userId, periodStart]): уникальный
  // индекс по тем же колонкам обслуживает те же выборки (list по
  // userId + periodStart range), отдельный обычный был бы дублем.
  //
  // Создаётся ДО `prisma db push` скриптом prisma/ensure-salary-unique.ts:
  // db push считает добавление уникального ограничения потенциально
  // разрушительным и требует --accept-data-loss, который мы намеренно не
  // используем (см. DEPLOY.md и ensure-commission-unique.ts).
  @@unique([userId, periodStart])
  @@index([status])
}

// ============================================================
// DAILY REPORTS — ежедневные/недельные отчёты сотрудника (ТЗ §3.6)
// ============================================================
// Сотрудник раз в день записывает: количество звонков, число встреч, активность.
// Эти данные дополняют автоматически собираемые KPI.
model DailyReport {
  id                    String   @id @default(uuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date                  DateTime @db.Date
  callsCount            Int      @default(0)
  meetingsCount         Int      @default(0)
  applicationsContacted Int      @default(0)
  // ТЗ §3.6: сотрудник заполняет количество и сумму продаж
  salesCount            Int      @default(0)
  salesAmount           Float    @default(0)
  // Консультации отдела продаж — оффлайн (в офисе) и онлайн
  offlineConsultations  Int      @default(0)
  onlineConsultations   Int      @default(0)
  activitySummary       String? // что сделал за день (свободный текст)
  challenges            String? // блокеры/проблемы
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([userId, date])
  @@index([date])
}

// ==========================================================
// DATA ACCESS GRANT — точечная выдача доступа к данным
// конкретного сотрудника другому пользователю. Админ может
// разрешить кому-то видеть досье конкретного сотрудника.
// ==========================================================
model DataAccessGrant {
  id           String   @id @default(uuid())
  // Кому выдан доступ
  grantedToId  String
  grantedTo    User     @relation("AccessGrantee", fields: [grantedToId], references: [id], onDelete: Cascade)
  // Чьи данные можно смотреть
  targetUserId String
  targetUser   User     @relation("AccessTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  // Кто выдал (для аудита)
  grantedById  String?
  createdAt    DateTime @default(now())

  @@unique([grantedToId, targetUserId])
  @@index([grantedToId])
  @@index([targetUserId])
}

// ==========================================================
// CALL LOG — журнал звонков менеджеров. Пока ручное логирование
// (полная интеграция через программу требует SIP/WebRTC провайдера).
// ==========================================================
enum CallDirection {
  INCOMING
  OUTGOING
}

enum CallOutcome {
  ANSWERED // дозвонился, поговорили
  NO_ANSWER // не ответили
  BUSY // занято
  CALLBACK // договорились перезвонить
  CONVERTED // привело к продаже/заявке
}

model CallLog {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation("CallLogUser", fields: [userId], references: [id], onDelete: Cascade)
  // Кому звонили
  clientName      String
  clientPhone     String?
  studentId       String?
  student         Student?      @relation("CallLogStudent", fields: [studentId], references: [id], onDelete: SetNull)
  direction       CallDirection @default(OUTGOING)
  outcome         CallOutcome   @default(ANSWERED)
  // Длительность разговора в секундах (время на линии)
  durationSeconds Int           @default(0)
  notes           String?
  // URL записи разговора (если есть)
  recordingUrl    String?
  occurredAt      DateTime      @default(now())
  createdAt       DateTime      @default(now())

  @@index([userId, occurredAt])
  @@index([studentId])
}

// ============================================================
// CHAT — внутренний чат компании (ТЗ §3.8)
// ============================================================
enum ChatRoomType {
  GENERAL // общий чат компании
  TEAM // командный чат (для группы сотрудников)
  DIRECT // личный 1-на-1
}

model ChatRoom {
  id        String        @id @default(uuid())
  type      ChatRoomType
  title     String? // для TEAM/DIRECT — имя комнаты
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  members   ChatMember[]
  messages  ChatMessage[]

  @@index([type])
}

model ChatMember {
  id         String    @id @default(uuid())
  roomId     String
  room       ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt DateTime?
  joinedAt   DateTime  @default(now())

  @@unique([roomId, userId])
  @@index([userId])
}

model ChatMessage {
  id              String         @id @default(uuid())
  roomId          String
  room            ChatRoom       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  authorId        String
  author          User           @relation("ChatMessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  text            String
  // Список упомянутых userId (для @mentions)
  mentionsIds     String[]       @default([])
  // ТЗ §3.8 + Telegram-style features:
  // attachments — массив объектов { url, filename, originalName, mimeType, size }.
  // replyToId — id сообщения, на которое отвечает (для quote-блока).
  // isPinned — закреплено в шапке чата.
  // deletedAt — soft-delete: text="" + deletedAt set, чтобы UI показал "сообщение удалено".
  // forwardedFromId — id оригинала (если переслано).
  attachments     Json?
  replyToId       String?
  replyTo         ChatMessage?   @relation("ChatMessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies         ChatMessage[]  @relation("ChatMessageReply")
  forwardedFromId String?
  forwardedFrom   ChatMessage?   @relation("ChatMessageForward", fields: [forwardedFromId], references: [id], onDelete: SetNull)
  forwards        ChatMessage[]  @relation("ChatMessageForward")
  isPinned        Boolean        @default(false)
  deletedAt       DateTime?
  reactions       ChatReaction[]
  createdAt       DateTime       @default(now())
  editedAt        DateTime?

  @@index([roomId, createdAt])
  @@index([authorId])
  @@index([roomId, isPinned])
}

// ============================================================
// ChatReaction — реакции на сообщения (Telegram-style ❤️ 👍 etc.)
// ============================================================
model ChatReaction {
  id        String      @id @default(uuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation("ChatReactionUser", fields: [userId], references: [id], onDelete: Cascade)
  emoji     String // например "❤️", "👍" — стандартные unicode emojis
  createdAt DateTime    @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

// ============================================================
// LMS — обучение (ТЗ §3.12)
// ============================================================
model Course {
  id          String       @id @default(uuid())
  title       String
  description String?
  coverUrl    String?
  published   Boolean      @default(false)
  authorId    String?
  author      User?        @relation("CourseAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  lessons     Lesson[]
  enrollments Enrollment[]

  @@index([published])
}

model Lesson {
  id            String           @id @default(uuid())
  courseId      String
  course        Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title         String
  content       String? // Markdown / rich text
  videoUrl      String?
  attachmentUrl String?
  order         Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  progress      LessonProgress[]

  @@index([courseId, order])
}

model Enrollment {
  id          String    @id @default(uuid())
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?

  @@unique([courseId, studentId])
  @@index([studentId])
}

model LessonProgress {
  id          String    @id @default(uuid())
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([lessonId, studentId])
  @@index([studentId])
}

// ============================================================
// INTERACTIONS — журнал общения с клиентом (ТЗ §3.2 «История взаимодействий», §3.3 «История общения»)
// ============================================================
enum InteractionType {
  CALL // звонок
  EMAIL // email-переписка
  MEETING // встреча
  NOTE // заметка менеджера
  SMS // sms
  TELEGRAM // переписка в TG
  WHATSAPP // переписка в WA
}

model Interaction {
  id               String          @id @default(uuid())
  studentId        String
  student          Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  authorId         String?
  author           User?           @relation("InteractionAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  type             InteractionType
  summary          String // краткое описание ("обсудили дедлайны", "клиент перезвонит во вторник")
  details          String? // длинная заметка
  // Студент видит запись, если visibleToStudent=true (по умолчанию true,
  // менеджер может пометить как "внутреннюю", не показывая клиенту).
  visibleToStudent Boolean         @default(true)
  occurredAt       DateTime        @default(now())
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([studentId, occurredAt])
  @@index([authorId])
  @@index([type])
}

// ============================================================
// PENALTIES — штрафы (ТЗ §3.9 «Нарушение → штраф»)
// ============================================================
enum PenaltyReason {
  LATE_ARRIVAL // опоздание утром (clockIn после scheduled start)
  LATE_FROM_LUNCH // опоздание после обеда (lunchIn после scheduled lunch end)
  ABSENCE // прогул
  TASK_OVERDUE // просроченная задача
  CUSTOM // ручной штраф админа
}

model Penalty {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    PenaltyReason
  amount    Float // в USD
  details   String // human-readable: "Опоздание 25 мин"
  date      DateTime      @default(now()) @db.Date
  // Учтён ли штраф в зарплатном расчёте (SalaryRecord)
  applied   Boolean       @default(false)
  createdAt DateTime      @default(now())

  @@index([userId, date])
  @@index([applied])
}

// ============================================================
// PAYMENTS — заявки на онлайн-оплату от клиента (ТЗ §2.1 «Оплата»)
// ============================================================
// Клиент в кабинете нажимает "Оплатить" → создаётся Payment(PENDING).
// Бухгалтер видит pending в /admin/finance → подтверждает с
// фактической суммой и методом → автоматически создаётся Transaction
// (INCOME / TUITION_PAYMENT) и Payment переводится в CONFIRMED.
enum PaymentStatus {
  PENDING // клиент инициировал, ждёт подтверждения бухгалтера
  CONFIRMED // бухгалтер подтвердил, транзакция создана
  REJECTED // бухгалтер отклонил
  CANCELLED // клиент отменил
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  CASH
  CRYPTO
  OTHER
}

model Payment {
  id            String        @id @default(uuid())
  studentId     String
  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount        Float
  currency      String        @default("TJS")
  method        PaymentMethod @default(BANK_TRANSFER)
  status        PaymentStatus @default(PENDING)
  comment       String?
  receiptUrl    String?
  // Кто подтвердил
  confirmedById String?
  confirmedBy   User?         @relation("PaymentConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  confirmedAt   DateTime?
  // Транзакция, созданная при подтверждении
  transactionId String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([studentId, status])
  @@index([status])
}

// ==========================================================
// PARTNER / REFERRAL SYSTEM
// Партнёрская программа: партнёр получает уникальную ref-ссылку,
// приводит клиентов, при оплате получает комиссию.
// ==========================================================

enum PartnerStatus {
  ACTIVE
  SUSPENDED // временно отключён админом
  BANNED // окончательно
}

enum CommissionStatus {
  PENDING // начислено, но ещё не выплачено
  APPROVED // одобрено к выплате
  PAID // выплачено
  REVERSED // отменено (если был refund)
}

enum PartnerPayoutStatus {
  REQUESTED
  PAID
  REJECTED
}

// Состояние строки outbox'а партнёрской комиссии (см. model CommissionOutbox).
enum CommissionOutboxStatus {
  PENDING // ещё не доставлено в ReferralsService
  DONE // отработано (начислено ИЛИ штатно пропущено — см. resultReason)
  FAILED // исчерпаны попытки, нужна ручная проверка (руководство уведомлено)
}

model Partner {
  id       String  @id @default(uuid())
  email    String  @unique
  password String // bcrypt hash
  fullName String
  phone    String?

  // Уникальный реферальный код (для URL ?ref=CODE и t.me/bot?start=CODE).
  // Генерируется при регистрации. Должен быть коротким и URL-safe.
  referralCode String @unique

  // Связка с Telegram аккаунтом (когда партнёр сам подключил бот).
  telegramId     String? @unique
  telegramHandle String?

  // Финансы — балансы хранятся в копейках/центах (Int) для точности.
  // Размер комиссии — % от суммы платежа клиента, привязанного к этому
  // партнёру. По умолчанию 30%, админ может поднять/опустить индивидуально.
  // LEGACY (Variant A flat-rate): commissionPct больше не используется в
  // расчёте — оставлен для обратной совместимости данных (Railway safe).
  // Формула перешла на commissionAmountCents (см. ниже).
  commissionPct    Int @default(30) // % (0-100) — LEGACY, не читается
  // Variant A: партнёр получает ФИКСИРОВАННУЮ сумму в TJS за КАЖДЫЙ
  // успешный платёж привлечённого клиента. Если клиент платит в 3
  // рассрочки — партнёр получает rate × 3. Хранится в копейках (100 = 1 TJS).
  // Дефолт 50000 копеек = 500 TJS. FOUNDER выставляет per partner.
  commissionAmountCents Int @default(50000)
  balanceCents     Int @default(0) // доступно к выплате
  totalEarnedCents Int @default(0) // всего заработал (lifetime)
  totalPaidCents   Int @default(0) // всего выплачено

  status PartnerStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clicks       ReferralClick[]
  attributions ReferralAttribution[]
  commissions  Commission[]
  payouts      PartnerPayout[]

  @@index([status])
  @@index([referralCode])
}

// Лог кликов по реферальной ссылке. Источник статистики "переходов".
model ReferralClick {
  id        String  @id @default(uuid())
  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  // Куда привёл клик: SITE | BOT. Бот = ?start=CODE в Telegram.
  source      String  @default("SITE")
  // Track referer/UA/IP (для антифрода и аналитики)
  ip          String?
  userAgent   String?
  referer     String?
  // Простой fingerprint для дедупликации (ip+ua hash) — чтобы один и тот же
  // пользователь не накручивал клики по F5.
  fingerprint String?

  createdAt DateTime @default(now())

  @@index([partnerId, createdAt])
  @@index([fingerprint])
}

// Привязка клиента к партнёру. Создаётся при ПЕРВОМ значимом действии
// (регистрация студента/заявка с лендинга/Telegram /start).
// При оплате читается чтобы определить кого премировать.
model ReferralAttribution {
  id        String  @id @default(uuid())
  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  // Один из этих идентификаторов клиента:
  studentId      String?
  applicationId  String?
  telegramUserId String? // для оплат через бот
  emailHint      String? // fallback

  source    String    @default("SITE") // SITE | BOT
  createdAt DateTime  @default(now())
  // TTL — атрибуция действительна 90 дней по умолчанию.
  expiresAt DateTime?

  // ОДНА комиссия за КЛИЕНТА, а не за платёж («один раз за клиента» —
  // решение основателя). Сделка, оплаченная в 4 рассрочки, начисляет
  // партнёру ровно один раз — на первом одобренном платеже.
  //
  // commissionedAt != null == комиссия по этому клиенту УЖЕ начислена,
  // повторно начислять нельзя никогда.
  //
  // ВАЖНО: guard «один раз за клиента» — это НЕ «одна строка = одно
  // начисление». Строк на одного клиента бывает несколько: повторная отправка
  // формы с лендинга по той же ?ref= создаёт новую строку с новым
  // applicationId (клиента в тот момент опознать нечем — ни studentId, ни
  // telegramUserId ещё нет). Пока штамп ставился на ОДНУ найденную строку —
  // самую свежую, — вторая строка того же клиента приходила с commissionedAt
  // = NULL и начисляла партнёру второй раз за того же человека.
  //
  // Поэтому штамп проставляется условным апдейтом
  // (WHERE <идентичность клиента> AND commissionedAt IS NULL) сразу по ВСЕМ
  // строкам клиента, в одной транзакции с созданием Commission — см.
  // ReferralsService.creditCommissionForAttributionOnce. Второй, независимый
  // backstop живёт в БД: Commission.@@unique([partnerId, studentId]).
  // Отдельный @@index на commissionedAt не заводим: запрос всегда сначала
  // сужается по идентичности клиента (studentId/applicationId/telegramUserId
  // — под каждым свой индекс ниже), а commissionedAt лишь фильтрует уже
  // отобранные единицы строк.
  commissionedAt DateTime?
  // Ссылка на созданную Commission (аудит: из карточки клиента видно, какое
  // именно начисление породила эта атрибуция). Без FK-связи — Commission не
  // должна каскадно тянуть за собой атрибуцию.
  commissionId   String?

  @@index([partnerId, createdAt])
  @@index([studentId])
  @@index([applicationId])
  @@index([telegramUserId])
}

// Начисление партнёру по факту успешной оплаты клиента.
model Commission {
  id        String  @id @default(uuid())
  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  // Источник: одна из этих связок
  paymentId     String? // студенческий Payment
  transactionId String? // финансовая Transaction

  // КЛИЕНТ, за которого начислено. Ключ правила основателя «один раз за
  // клиента»: вместе с @@unique([partnerId, studentId]) ниже это
  // ЕДИНСТВЕННЫЙ guard, который живёт в БД, а не в порядке чтения строк.
  //
  // Зачем он нужен помимо ReferralAttribution.commissionedAt: строк
  // атрибуции на одного клиента бывает НЕСКОЛЬКО (повторная отправка формы
  // с лендинга по той же ?ref= создаёт новую строку с новым applicationId и
  // commissionedAt = NULL). Пока штамп ставился на одну найденную строку,
  // вторая, свежая и неотштампованная, начисляла партнёру ещё раз за того же
  // клиента. Теперь дубль упирается в P2002 и транзакция откатывается
  // целиком — баланс партнёра не трогается.
  //
  // Без FK-связи на Student: Commission — финансовая история, она обязана
  // пережить удаление карточки студента (тот же приём, что у
  // ReferralAttribution.commissionId).
  //
  // NULL допустим и НЕ конфликтует: Postgres считает NULL'ы различными, так
  // что легаси-строки (начисленные до появления поля) и начисления по
  // telegram-клиентам без Student живут как раньше. Задним числом поле НЕ
  // заполняется — прошлые сделки не трогаем.
  studentId     String?

  amountCents     Int // итоговое начисление (в копейках/центах)
  baseAmountCents Int // сумма платежа, с которой считалось
  percent         Int // % на момент начисления (фриз)
  currency        String  @default("TJS") // валюта начисления (amountCents) — flat-rate всегда TJS
  baseCurrency    String  @default("TJS") // валюта платежа клиента (baseAmountCents) — USD/EUR/RUB/…
  note            String?

  status     CommissionStatus @default(PENDING)
  approvedAt DateTime?
  paidAt     DateTime?
  reversedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([partnerId, paymentId])
  @@unique([partnerId, transactionId])
  // «Один раз за КЛИЕНТА» на уровне БД. Работает как partial unique index:
  // NULL'ы в Postgres различны, поэтому ограничение действует ровно на строки
  // с заполненным studentId и не мешает ни легаси-записям, ни начислениям без
  // студента. Создаётся `prisma db push` без потери данных: колонка новая, у
  // всех существующих строк studentId = NULL, конфликтующих пар нет.
  @@unique([partnerId, studentId])
  @@index([partnerId, status])
  @@index([paymentId])
  @@index([transactionId])
  @@index([createdAt])
}

// Запрос/выплата средств партнёру.
model PartnerPayout {
  id        String  @id @default(uuid())
  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  amountCents Int
  currency    String  @default("TJS")
  method      String? // CARD/CRYPTO/CASH/OTHER
  details     String? // реквизиты которые партнёр прислал
  note        String?

  status      PartnerPayoutStatus @default(REQUESTED)
  requestedAt DateTime            @default(now())
  paidAt      DateTime?
  rejectedAt  DateTime?

  @@index([partnerId, status])
  @@index([status])
}

/// TRANSACTIONAL OUTBOX для партнёрской комиссии по сделкам.
///
/// ЗАЧЕМ. approvePayment коммитит одобрение платежа (Transaction INCOME,
/// Student, Application) ОДНОЙ транзакцией, а начисление партнёру идёт
/// ОТДЕЛЬНОЙ транзакцией уже после COMMIT'а — иначе сбой партнёрской части
/// откатывал бы одобрение бухгалтера (см. комментарий в
/// submissions.service.ts, блок «Партнёрская комиссия»). Пока эти две
/// транзакции ничем не связаны, смерть процесса МЕЖДУ ними (деплой,
/// рестарт контейнера, eviction пода, обрыв соединения с БД) означала:
/// платёж одобрен, доход в отчёте, партнёр не получил ничего и никогда не
/// получит — commissionedAt остался null, но по одноплатёжной сделке
/// второго approve, который «догнал» бы начисление, уже не будет.
///
/// КАК. Строка PENDING пишется ВНУТРИ транзакции одобрения — она
/// коммитится атомарно вместе с платежом или не появляется вовсе. Сразу
/// после COMMIT'а approvePayment пытается отработать её сам (быстрый путь,
/// комиссия начисляется в те же миллисекунды, что и раньше). Если процесс
/// умер до/во время этого — строка остаётся PENDING, и её добирает cron
/// (CronService.drainCommissionOutbox). Повторная доставка безопасна:
/// creditCommissionForAttributionOnce идемпотентен через CAS-штамп
/// ReferralAttribution.commissionedAt, поэтому at-least-once не может
/// заплатить дважды.
///
/// ЭТО ТОЛЬКО ДЛЯ НОВЫХ ОДОБРЕНИЙ. Задним числом строки не создаются:
/// прошлые сделки остаются как есть (осознанное решение — не трогать уже
/// закрытые балансы партнёров).
model CommissionOutbox {
  id String @id @default(uuid())

  // Что именно породило начисление. Без FK-связей: outbox — журнал
  // намерения, он не должен каскадно удаляться вместе со сделкой и не
  // должен мешать удалению студента/платежа.
  submissionId         String
  // @unique — один платёж порождает ровно одну попытку начисления.
  // Второй approve того же платежа невозможен (CAS на status), так что
  // конфликт здесь означал бы баг, а не гонку.
  paymentId            String  @unique
  financeTransactionId String
  studentId            String
  // Обе заявки сделки, ровно как их передаёт немедленное начисление:
  //  - applicationId — свежая SUCCESSFUL_LEAD, созданная этим одобрением;
  //  - sourceApplicationId — лид, из которого сделку завели; именно на нём
  //    висит атрибуция с лендинга.
  // Хранятся обе, потому что искать атрибуцию надо по обеим (см.
  // ReferralClientRef.applicationIds). Если повтор будет знать только одну,
  // восстановленное начисление уйдёт в no-attribution — то есть outbox молча
  // «доставит» пустоту вместо потерянной комиссии.
  applicationId        String?
  sourceApplicationId  String?

  // Аргументы начисления, замороженные на момент одобрения: cron не должен
  // пересчитывать базу по «сегодняшнему» состоянию сделки.
  baseAmountCents Int
  baseCurrency    String  @default("TJS")
  sourceLabel     String?

  status   CommissionOutboxStatus @default(PENDING)
  attempts Int                    @default(0)
  /// Итог доставки: credited | no-attribution | already-credited |
  /// race-lost | attribution-expired | partner-inactive | zero-rate |
  /// duplicate-commission | payment-not-approved. Нужен, чтобы по DONE-строке
  /// было видно, начислили или осознанно пропустили.
  resultReason String?
  /// Текст последней ошибки доставки (для разбора FAILED-строк).
  lastError    String?
  /// Лизинг/бэкофф: строку берёт в работу только тот, кто прошёл CAS по
  /// nextAttemptAt <= now(). Защищает от двойной обработки при нескольких
  /// репликах и растягивает ретраи при устойчивом сбое.
  nextAttemptAt DateTime @default(now())

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  processedAt DateTime?

  // Рабочий индекс дренажа: PENDING со сроком попытки в прошлом.
  @@index([status, nextAttemptAt])
  @@index([submissionId])
}

// Сессия пользователя Telegram-бота — храним привязку telegramUserId к
// реферальному коду (для атрибуции) + текущее состояние воронки.
model BotSession {
  id               String  @id @default(uuid())
  telegramUserId   String  @unique
  telegramUsername String?
  firstName        String?
  lastName         String?

  // К какому партнёру привязан этот пользователь (по /start=CODE)
  partnerCode  String?
  // Состояние воронки (для прогрева): 0..N — текущий шаг
  funnelStep   Int       @default(0)
  // Купил ли уже доступ
  hasPurchased Boolean   @default(false)
  purchasedAt  DateTime?

  // Когда последний раз отправляли follow-up
  lastNudgeAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partnerCode])
  @@index([hasPurchased])
}

// --- Sprint C: рабочий график, штрафы, гео-зона ---

// Рабочий график. Одна строка = (день недели × сотрудник | глобальный default).
// userId=null означает дефолт компании. Любой сотрудник может иметь личное
// переопределение для каждого дня. Время в минутах от полуночи (0-1439).
// FOUNDER редактирует свой и чужие графики (по ТЗ).
model WorkSchedule {
  id               String   @id @default(uuid())
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekday          Weekday
  isWorkday        Boolean  @default(true)
  startMinute      Int      @default(540) // 09:00
  endMinute        Int      @default(1080) // 18:00
  lunchStartMinute Int?     @default(720) // 12:00
  lunchEndMinute   Int?     @default(780) // 13:00
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, weekday])
  @@index([userId])
}

// Ступенчатая шкала штрафов за опоздание. Несколько правил образуют
// прогрессию: 10-30мин → 50 TJS, 30-60мин → 150, 60+ → 300. Опоздание
// в минутах попадает в первое правило, где minLateMinutes <= late <
// maxLateMinutes (или maxLateMinutes = null = бесконечность).
model PenaltyRule {
  id             String   @id @default(uuid())
  minLateMinutes Int // нижняя граница (включительно)
  maxLateMinutes Int? // верхняя граница (исключительно). null = ∞.
  amount         Float
  currency       String   @default("TJS")
  isActive       Boolean  @default(true)
  comment        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive, minLateMinutes])
}

/// Тарифная сетка комиссионного вознаграждения (ТЗ-доработка).
/// FOUNDER задаёт в Настройки → Зарплата. По умолчанию seed заливает
/// 5 этапов: 0-49990→4%, 50000-99990→5%, 100000-149990→6%,
/// 150000-199990→7%, 200000+→8%. Сумма продаж сотрудника за период
/// попадает в один этап (flat-per-tier), и весь объём умножается на
/// процент этого этапа. Если у юзера выставлен персональный
/// bonusPercent > 0, он перебивает сетку.
model BonusTier {
  id        String   @id @default(uuid())
  minAmount Float // нижняя граница (включительно)
  maxAmount Float? // верхняя граница (исключительно). null = ∞
  percent   Float // процент от продаж
  currency  String   @default("TJS")
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, order])
  @@index([isActive, minAmount])
}

// Рабочая локация (геозона). Сотрудник может нажать «Начать работу»
// ТОЛЬКО внутри радиуса. Допускается несколько локаций (офис ТЖ, офис
// в Душанбе и т.п.), но активная в момент времени только одна (isActive).
model WorkLocation {
  id           String   @id @default(uuid())
  name         String   @default("Главный офис")
  latitude     Float
  longitude    Float
  radiusMeters Int      @default(150)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive])
}

// --- Sprint F: Внешние интеграции (WhatsApp / Instagram / Telegram) ---

enum ExternalMessageChannel {
  WHATSAPP
  INSTAGRAM
  TELEGRAM
  SMS
}

enum ExternalMessageDirection {
  IN
  OUT
}

enum ExternalMessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

// Универсальное хранилище сообщений из внешних каналов. Сюда падает
// inbox от WhatsApp/Instagram webhooks; и outbox для отправленных
// сообщений из CRM. Может быть привязано к клиенту (Application или
// Student) — для построения единой ленты переписки в карточке клиента.
model ExternalMessage {
  id            String                   @id @default(uuid())
  externalId    String? // id у внешнего провайдера
  channel       ExternalMessageChannel
  direction     ExternalMessageDirection
  status        ExternalMessageStatus    @default(PENDING)
  fromHandle    String? // e.g. +992...., @insta_user
  toHandle      String?
  content       String? // текст
  mediaUrl      String?
  applicationId String?
  studentId     String?
  sentAt        DateTime?
  receivedAt    DateTime?
  rawPayload    Json? // полный payload от webhook'а
  createdAt     DateTime                 @default(now())

  @@index([channel, direction])
  @@index([applicationId])
  @@index([studentId])
  @@index([externalId])
}

// Кампания массовой рассылки. По ТЗ §10 — рассылка по всем лидам
// (акции, новые программы).
enum MassMailStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELED
  FAILED
}

model MassMailCampaign {
  id          String                 @id @default(uuid())
  name        String
  channel     ExternalMessageChannel
  subject     String?
  body        String // markdown / plain
  audience    Json // {filter: 'all-leads' | 'paid-students' | ...}
  status      MassMailStatus         @default(DRAFT)
  sentCount   Int                    @default(0)
  failedCount Int                    @default(0)
  scheduledAt DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdById String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([status])
}

// --- Sprint E: Воронки продаж ---

// Воронка продаж. Может быть несколько — например, отдельная для
// бакалавриата, магистратуры, языковых курсов. isDefault указывает
// воронку, в которую попадают новые лиды без явного выбора.
model Pipeline {
  id           String          @id @default(uuid())
  name         String
  description  String?
  isDefault    Boolean         @default(false)
  isActive     Boolean         @default(true)
  stages       PipelineStage[]
  applications Application[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([isActive])
}

// Этап воронки. Порядок задаётся числом order. isClosingStage =
// true означает «финальный успешный этап» (зачислен).
model PipelineStage {
  id             String        @id @default(uuid())
  pipelineId     String
  pipeline       Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  applications   Application[]
  name           String
  order          Int
  color          String? // hex для UI карточки
  isClosingStage Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([pipelineId, order])
  @@index([pipelineId])
}

// ============================================================
// CUSTOM ROLES — пользовательские роли с произвольным набором
// доступов. FOUNDER может создать роль вида «Таргетолог» с
// доступом к разделам "Заявки" и "KPI" и привязать к ней
// сотрудника через UserDetail.
// permissions — массив строковых ключей из PERMISSION_CATALOG
// (см. backend/src/auth/permissions.ts).
// ============================================================
model CustomRole {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions String[] @default([])
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@index([isActive])
}

// ============================================================
// SALE SUBMISSIONS — менеджер сам оформляет закрытую сделку
// (студент + контракт + платежи), FOUNDER одобряет как 2FA.
// После APPROVE первого платежа атомарно создаются Student
// (если новый), Application, FinanceTransaction. Последующие
// платежи добавляются к существующей Submission.
// Бонус менеджера = sum(APPROVED payments за месяц) × bonusPercent.
// ============================================================
enum SubmissionStatus {
  ACTIVE // контракт открыт, могут добавляться платежи
  COMPLETED // оплачено полностью, закрыто менеджером
  CANCELLED // отменено (студент отказался / возврат)
}

enum SubmissionPaymentStatus {
  PENDING // менеджер прислал, ждёт одобрения FOUNDER
  APPROVED // FOUNDER сверил с реальным платежом → засчитано в доход + бонус
  REJECTED // FOUNDER отклонил (фейк/ошибка), менеджер должен переделать
}

enum SubmissionPaymentMethod {
  TRANSFER // банковский перевод на реквизиты компании
  CASH // наличкой, вечером пополняется на счёт + скрин пополнения
  OTHER
}

model SaleSubmission {
  id                              String           @id @default(uuid())
  // Студент: если studentId задан — существующий, иначе создаётся при
  // первом APPROVE из полей snapshot ниже.
  studentId                       String?
  student                         Student?         @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: SetNull)
  // Snapshot данных нового студента — заполняется если studentId null.
  // После первого APPROVE сюда не пишем; ссылка на созданного — через studentId.
  newStudentName                  String?
  newStudentPhone                 String?
  newStudentEmail                 String?
  newStudentPassportUrls          String[]         @default([]) // фото/PDF паспорта (Multer upload)
  // Snapshot метаданных загруженных файлов паспорта — заполняется при
  // создании сделки из ответа /submissions/upload. Используется при
  // APPROVE для создания Document с реальным mimeType/size/originalName
  // (иначе в БД сохранится placeholder 'application/octet-stream'/0/'passport').
  newStudentPassportMimes         String[]         @default([])
  newStudentPassportSizes         Int[]            @default([])
  newStudentPassportOriginalNames String[]         @default([])
  // Программа — обязательна на уровне сервиса (валидируется в
  // SubmissionsService.create), но допускает null после удаления Program,
  // чтобы история сделок сохранялась и каталог можно было чистить.
  programId                       String?
  program                         Program?         @relation("ProgramSubmissions", fields: [programId], references: [id], onDelete: SetNull)
  // Менеджер — ТЕКУЩИЙ ВЛАДЕЛЕЦ сделки: кому она видна в «Мои сделки», кого
  // уведомляем о разборе платежа, чьи права проверяются на правку.
  // Это НЕ источник истины для зарплаты — см. SubmissionPayment.creditedManagerId.
  managerId                       String?
  // Удалили сотрудника-менеджера → менеджер у сделки обнуляется, сделка и её
  // одобренные платежи остаются, чтобы бухгалтерия не теряла финансовую историю.
  //
  // AUDIT HIGH (Q5, manager attribution). Здесь стояло «бонусы за прошлые
  // периоды по-прежнему считаются по reviewedAt/amount» — это было НЕПРАВДОЙ.
  // Объём атрибутировался фильтром `submission: { managerId }`, то есть по
  // ТЕКУЩЕМУ владельцу сделки на момент пересчёта. А onDelete: SetNull ниже
  // обнулял managerId у ВСЕХ сделок удалённого сотрудника (UsersService.remove
  // делает hard prisma.user.delete) — и весь его исторический объём становился
  // непересчитываемым: повторный salary.preview() за любой прошлый месяц
  // возвращал salesAmount = 0. Выживали только уже замороженные SalaryRecord.
  //
  // ФИКС: кредитуемый менеджер снапшотится на SubmissionPayment.creditedManagerId
  // в момент APPROVE (см. модель ниже). Зарплата и finance-разрез «доход по
  // менеджерам» читают ТОЛЬКО снапшот. Это же закрывает вторую дыру: если
  // когда-нибудь появится ручка переназначения сделки, уже одобренный объём
  // месяца НЕ переедет к новому владельцу задним числом.
  manager                         User?            @relation("SubmissionManager", fields: [managerId], references: [id], onDelete: SetNull)
  // Контракт — PDF/фото подписанного контракта.
  contractUrls                    String[]         @default([])
  // Snapshot метаданных контракт-файлов (см. комментарий выше про паспорт).
  contractMimes                   String[]         @default([])
  contractSizes                   Int[]            @default([])
  contractOriginalNames           String[]         @default([])
  // Полная сумма контракта (для отслеживания «сколько ещё должен»).
  totalAmount                     Float
  currency                        String           @default("USD")
  // Статус всей сделки. ACTIVE пока есть открытые платежи или сумма не
  // покрыта. Менеджер сам помечает COMPLETED когда оплачено всё, или
  // CANCELLED при возврате/отказе.
  status                          SubmissionStatus @default(ACTIVE)
  // Куда оформился (создаётся при APPROVE первого платежа).
  applicationId                   String?          @unique
  application                     Application?     @relation("SubmissionApplication", fields: [applicationId], references: [id], onDelete: SetNull)
  // Заявка-ИСТОЧНИК: лид, из которого менеджер завёл сделку (кнопка
  // «Создать сделку» в карточке заявки). Это НЕ то же самое, что
  // applicationId выше: тот создаётся ЗАНОВО (status=SUCCESSFUL_LEAD) при
  // одобрении первого платежа и перезаписывается — хранить в нём источник
  // нельзя, он бы затёрся ровно в тот момент, когда нужен.
  //
  // ЗАЧЕМ. Реферальная атрибуция с лендинга висит на ЛИДЕ
  // (ReferralAttribution.applicationId): в момент отправки формы Student ещё
  // не существует. Student появляется только когда менеджер переводит заявку
  // NEW_LEAD → IN_PROCESSING (там же back-fill ReferralAttribution.studentId).
  // Если менеджер этот шаг пропустил и завёл сделку вкладкой «Новый» по имени
  // и телефону лида, у сделки нет ни studentId, ни applicationId — моста к
  // партнёру не существует вовсе: блок «Партнёр» пуст даже у основателя, а на
  // одобрении первого платежа поиск уходит по СВЕЖЕсозданному студенту, у
  // которого есть только новая SUCCESSFUL_LEAD-заявка. Итог — no-attribution
  // и молча неоплаченный партнёр. Эта колонка и есть недостающий мост.
  //
  // НЕ @unique (в отличие от applicationId): по одному лиду можно завести
  // несколько сделок — первую отменили, вторая настоящая.
  sourceApplicationId             String?
  sourceApplication               Application?     @relation("SubmissionSourceApplication", fields: [sourceApplicationId], references: [id], onDelete: SetNull)
  notes                           String?
  createdAt                       DateTime         @default(now())
  updatedAt                       DateTime         @updatedAt
  // Когда был APPROVED первый платёж (создались Student/Application).
  firstApprovedAt                 DateTime?

  payments SubmissionPayment[]

  // Этапы рассрочки, материализованные из шаблона программы при создании
  // сделки. Cascade — без сделки этапы смысла не имеют.
  paymentStages PaymentStage[]

  @@index([managerId, createdAt])
  @@index([status])
  @@index([studentId])
  @@index([programId])
  @@index([sourceApplicationId])
}

model SubmissionPayment {
  id                   String                  @id @default(uuid())
  submissionId         String
  submission           SaleSubmission          @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  // Сколько фактически внёс этим траншем.
  amount               Float
  paymentMethod        SubmissionPaymentMethod @default(TRANSFER)
  // Когда менеджер получил деньги.
  paidAt               DateTime
  // Чек/скриншот перевода — обязательно при TRANSFER.
  receiptUrls          String[]                @default([])
  // Если налом: вечером кладёт на счёт компании, прикладывает скрин
  // банковской выписки или фото слипа.
  depositProofUrls     String[]                @default([])
  // План следующего платежа (если контракт не закрыт полностью).
  nextDueDate          DateTime?
  nextDueAmount        Float?
  notes                String?
  status               SubmissionPaymentStatus @default(PENDING)
  // FOUNDER одобрение / отклонение.
  reviewedById         String?
  reviewedBy           User?                   @relation("SubmissionPaymentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt           DateTime?
  rejectReason         String?
  // Связанная финансовая транзакция (создаётся на APPROVE) — для
  // дашборда доходов в Finance модуле.
  financeTransactionId String?                 @unique
  // СНАПШОТ менеджера, которому этот платёж засчитан в бонусную базу.
  // Пишется РОВНО ОДИН РАЗ — тем же CAS-апдейтом, что переводит платёж
  // PENDING → APPROVED, из SaleSubmission.managerId, прочитанного под тем же
  // `SELECT ... FOR UPDATE` (submissions.service.ts, approvePayment).
  // Приоритетный источник истины для зарплатного объёма
  // (common/manager-bonus-volume.ts) и для finance-разреза «доход по
  // менеджерам» в части tuition-прихода: читается первым, с откатом на
  // SaleSubmission.managerId там, где снапшота ещё нет.
  //
  // ПОЧЕМУ БЕЗ @relation/FK. Это снапшот, а не ссылка: он обязан пережить
  // удаление сотрудника. Любой FK на User здесь имел бы либо onDelete: SetNull
  // — то есть ровно ту дыру, ради которой колонка и заведена, — либо
  // Restrict/NoAction, и тогда UsersService.remove() падал бы с FK-ошибкой на
  // каждом сотруднике, у которого хоть раз одобрили платёж. Поэтому голый
  // scalar; имя менеджера для UI резолвится отдельным findMany по id (так уже
  // делает finance.service).
  //
  // NULL означает одно из трёх: платёж никогда не был одобрен
  // (PENDING/REJECTED), на момент одобрения у сделки не было менеджера, либо
  // строка одобрена ДО появления колонки. Бэкфилла нет и не требуется:
  // common/manager-bonus-volume.ts на пустом снапшоте падает обратно на
  // SaleSubmission.managerId — то же значение, которое код возвращал раньше.
  // Именно поэтому колонку нельзя сделать единственным фильтром: на проде она
  // появляется пустой у всех существующих платежей, и объём обнулился бы
  // у каждого менеджера разом.
  creditedManagerId    String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  // Этапы рассрочки, погашенные этим платежом при APPROVE. Единственный
  // путь, которым PaymentStage становится PAID.
  settledStages PaymentStage[] @relation("PaymentStageSettledBy")

  @@index([submissionId, paidAt])
  @@index([status])
  @@index([reviewedAt])
  // Основной зарплатный запрос: объём одного менеджера за календарный месяц.
  @@index([creditedManagerId, status, reviewedAt])
}

// Audit fix (HIGH, multi-replica rate-limit inflation + reset-on-deploy):
// Дефолтный @nestjs/throttler хранит бакеты в in-memory Map внутри
// ThrottlerStorageService. На Railway при scale=N реплик каждая держит свою
// собственную мапу, поэтому реальный лимит для пользователя = declared × N
// (LB раскидывает запросы round-robin по подам). Anti-bonus-inflation guard
// на POST /finance/transactions (20/min) на 3 подах превращается в 60/min.
// Плюс любой redeploy обнуляет счётчики → brute-force protection на
// POST /student-auth/login и POST /applications/public обнуляется на каждом
// push'е. Стандартное решение — Redis-backed storage, но Redis-клиента в
// проекте нет и добавлять новую dep нельзя. Поэтому шарим бакеты через
// уже существующий Postgres (см. src/common/throttler-prisma.storage.ts).
//
// Один row = одно активное окно бакета для (throttlerName × tracker).
// `key` — sha256 из throttler.guard.generateKey, поэтому 64 hex-символа
// (короткое @id без @db.VarChar достаточно, Postgres хранит эффективно).
// `throttlerName` не участвует в логике (сам key уже уникален per throttler),
// хранится для диагностики / метрик.
model ThrottleHit {
  key           String    @id
  throttlerName String
  totalHits     Int       @default(0)
  // Конец текущего окна TTL. После него счётчик сбрасывается на следующем
  // hit'е того же ключа. Для GC мёртвых окон делаем opportunistic cleanup
  // изнутри increment() (см. storage), отдельный cron не заводим.
  expiresAt     DateTime
  // Если превысили limit — тут время до разблокировки. NULL = не заблокирован.
  // Может быть > expiresAt: длинный blockDuration переживает окно.
  blockedUntil  DateTime?
  updatedAt     DateTime  @updatedAt

  @@index([expiresAt])
  @@index([blockedUntil])
}

// ============================================================
// REVENUE SCHEME — FOUNDER-редактируемая схема распределения выручки.
// ============================================================
// FOUNDER настраивает через /admin/revenue-scheme, что делать с приходящими
// деньгами: % на благотворительность / налоги / отделы, ФОТ фиксированными
// суммами, себестоимость услуги и т.д. Один RevenueScheme (isActive=true)
// на систему; при первом запуске сервис сеет дефолтную схему из image
// (см. RevenueSchemeService.onModuleInit — идемпотентно по count > 0).
//
// Кнопка «Reset» на UI сначала стирает buckets/items текущей схемы, а
// затем пересеевает дефолт из того же кода — ровно тот же путь, что и
// initial seed.
enum RevenueBucketKind {
  PERCENTAGE
  FIXED_SUM
}

model RevenueScheme {
  id        String          @id @default(uuid())
  name      String          @default("Основная схема")
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  buckets   RevenueBucket[]

  @@index([isActive])
}

model RevenueBucket {
  id       String              @id @default(uuid())
  schemeId String
  scheme   RevenueScheme       @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  kind     RevenueBucketKind
  name     String
  color    String?
  // 0..100 для kind=PERCENTAGE; NULL для FIXED_SUM. Валидация на уровне
  // сервиса (Prisma не умеет условные check-constraints без raw SQL).
  percent  Int?
  order    Int                 @default(0)
  items    RevenueBucketItem[]

  // Уникальный слот в рамках схемы: (schemeId, order) — защищает от
  // гонки в createBucket/reorder (два параллельных POST'а не смогут
  // сесть на один и тот же order). Уникальный индекс сам по себе
  // работает и как обычный [schemeId, order]-index для сортировки.
  @@unique([schemeId, order])
}

model RevenueBucketItem {
  id          String        @id @default(uuid())
  bucketId    String
  bucket      RevenueBucket @relation(fields: [bucketId], references: [id], onDelete: Cascade)
  name        String
  // Required для FIXED_SUM (валидатор в сервисе); nullable для PERCENTAGE
  // (там item — просто под-лейбл вроде «Таргет», «Съёмка Reels»).
  amountCents Int?
  order       Int           @default(0)
  // Опциональная привязка к сотруднику (для ФОТ). При удалении User
  // ссылка обнуляется, item остаётся — FOUNDER переназначит.
  userId      String?
  user        User?         @relation("RevenueBucketItemUser", fields: [userId], references: [id], onDelete: SetNull)

  // Уникальный слот в рамках bucket'а (см. коммент в RevenueBucket).
  @@unique([bucketId, order])
  @@index([userId])
}


// ============================================================
// STUDY GROUPS & CLASS SCHEDULE — расписание занятий по группам.
// ============================================================
// Единственный путь к расписанию — ГРУППА. Индивидуальный студент — это
// группа из одного человека (StudyGroup + один GroupMember), отдельной
// «персональной» ветки НЕТ и заводить её нельзя: иначе календарь, напоминания
// и кабинет студента пришлось бы писать дважды и они бы разъехались.
//
// Кто что видит: FOUNDER/ADMIN — все группы; преподаватель (User в
// StudyGroup.teacherId) — свои; студент (лендинг-кабинет) — только занятия
// групп, в которых он состоит (через GroupMember).
//
// Напоминание перед занятием шлёт CronService через уже существующий
// NotificationsService — второго канала уведомлений не заводим.
enum StudyGroupStatus {
  ACTIVE // группа занимается, сессии планируются
  ARCHIVED // отучились / расформирована; история занятий сохраняется
}

enum ClassSessionStatus {
  SCHEDULED // запланировано, ещё не прошло
  DONE // занятие состоялось
  CANCELLED // отменено (преподаватель заболел и т.п.), из кабинета скрывается
}

/// Учебная группа. Инвариант: расписание висит ТОЛЬКО на группе — у
/// ClassSession нет и не должно быть прямой ссылки на студента.
model StudyGroup {
  id          String           @id @default(uuid())
  name        String
  // Программа, по которой учится группа. Опциональна: бывают общие курсы
  // (языковая подготовка) вне каталога. Удалили Program → группа остаётся
  // с историей занятий, ссылка обнуляется.
  programId   String?
  program     Program?         @relation("ProgramStudyGroups", fields: [programId], references: [id], onDelete: SetNull)
  // Преподаватель — обычный User (отдельной роли TEACHER в enum Role нет,
  // права разруливает RolesGuard + принцип «свои группы»). Уволили/удалили
  // сотрудника → группа не пропадает, преподавателя переназначают.
  teacherId   String?
  teacher     User?            @relation("StudyGroupTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  status      StudyGroupStatus @default(ACTIVE)
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  members  GroupMember[]
  sessions ClassSession[]

  @@index([status])
  @@index([teacherId])
  @@index([programId])
  @@index([createdAt])
}

/// Членство студента в группе. Чистая join-строка со снапшотом даты входа.
/// Инвариант: один студент — максимум одна строка на группу (@@unique).
/// Cascade с ОБЕИХ сторон удаляет только саму строку членства: удаление
/// группы НЕ удаляет студентов, удаление студента НЕ удаляет группу.
model GroupMember {
  id        String     @id @default(uuid())
  groupId   String
  group     StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studentId String
  student   Student    @relation("StudentGroupMemberships", fields: [studentId], references: [id], onDelete: Cascade)
  joinedAt  DateTime   @default(now())

  @@unique([groupId, studentId])
  @@index([studentId])
}

/// Одно занятие группы. Основные запросы — «ближайшие занятия группы» и
/// «ближайшие занятия студента» (через GroupMember), отсюда
/// @@index([groupId, startsAt]).
model ClassSession {
  id             String             @id @default(uuid())
  groupId        String
  group          StudyGroup         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  // Границы занятия в UTC. Границы СУТОК для календаря и cron'ов считаются
  // только через common/tj-time.ts (Asia/Dushanbe), без сырой арифметики
  // над Date.
  startsAt       DateTime
  endsAt         DateTime
  topic          String?
  // Замена штатного преподавателя на конкретное занятие. NULL = ведёт
  // преподаватель группы (StudyGroup.teacherId).
  teacherId      String?
  teacher        User?              @relation("ClassSessionTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  status         ClassSessionStatus @default(SCHEDULED)
  // Идемпотентность напоминания: cron проставляет отметку, отправив
  // уведомление, и по этой сессии больше не срабатывает. Без колонки
  // повторный запуск (или рестарт пода) шлёт напоминание заново.
  reminderSentAt DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([groupId, startsAt])
  @@index([startsAt])
  // Выборка cron'а напоминаний: SCHEDULED в ближайшем окне.
  @@index([status, startsAt])
  @@index([teacherId])
}

// ============================================================
// INSTALLMENT PLANS — рассрочка по сделке (SaleSubmission).
// ============================================================
// Шаблон живёт на программе (ProgramInstallmentStage): упорядоченные этапы
// с долей в процентах и сдвигом в днях от старта сделки. При создании сделки
// шаблон МАТЕРИАЛИЗУЕТСЯ в строки PaymentStage — дальше менеджер правит суммы
// и даты руками, шаблон на уже созданные этапы больше не влияет.
//
// Деньги: Float в тех же единицах, что SaleSubmission.totalAmount и
// SubmissionPayment.amount (целые единицы валюты, НЕ центы; в центы переводится
// только партнёрская комиссия на своей границе). Своей валюты у этапа нет —
// наследуется из submission.currency.
//
// Инвариант сумм: sum(PaymentStage.amount) == SaleSubmission.totalAmount ТОЧНО.
// Остаток от округления процентов кладётся на ПОСЛЕДНИЙ этап (сравнение — с
// уже существующим PAYMENT_PHASE_EPSILON). Держится на всех трёх путях, где
// двигается любая сторона равенства: материализация (allocateStageAmounts),
// правка суммы этапа (rebalancePlanForStageEditTx — разница переносится на
// последний неоплаченный этап) и правка суммы контракта
// (reallocateOnTotalChangeTx — неоплаченные этапы пересобираются под новую
// цену). Оплаченные этапы не двигает никто: они сведены с платежами.
//
// Инвариант статуса: PAID выставляется ТОЛЬКО при одобрении SubmissionPayment
// (гасятся самые ранние неоплаченные этапы, которые платёж покрывает).
// Второго места, где этап становится PAID, нет.
//
// OVERDUE проставляет суточный cron в Asia/Dushanbe; он же поднимает уже
// существующий Application.paymentPending (второй источник правды про долг
// не заводим) и уведомляет ответственного менеджера — студента НЕ уведомляет.

/// Этап шаблона рассрочки у программы. Инвариант: sum(percent) по программе
/// == 100 (проверяется в сервисе — условных check-constraint'ов Prisma не
/// умеет). Порядок этапов уникален в рамках программы, чтобы параллельные
/// правки не сели на один слот (та же схема, что у RevenueBucket).
model ProgramInstallmentStage {
  id         String   @id @default(uuid())
  programId  String
  program    Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  // Порядковый номер этапа (нормализует сервис при сохранении шаблона).
  order      Int
  title      String? // «Первый взнос», «Второй платёж» …
  // Доля этапа от полной суммы контракта, 0..100. Float, а не Int: рассрочка
  // на три части — это 33.33 / 33.33 / 33.34.
  percent    Float
  // Сдвиг срока от старта сделки (SaleSubmission.createdAt) в днях.
  // 0 = «в день заключения». Дата считается через common/tj-time.ts.
  offsetDays Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Уникальный слот в рамках программы; он же индекс для сортировки.
  @@unique([programId, order])
}

enum PaymentStageStatus {
  PENDING // ждёт оплаты, срок ещё не вышел
  PAID // погашен одобренным SubmissionPayment (единственный путь)
  OVERDUE // срок прошёл, денег нет — ставит суточный cron Asia/Dushanbe
}

/// Материализованный этап рассрочки конкретной сделки. Живёт и умирает вместе
/// со сделкой (Cascade) — без сделки этап смысла не имеет.
/// Инвариант: (submissionId, order) уникальна — защищает от двойной
/// материализации шаблона при гонке двух параллельных созданий сделки.
model PaymentStage {
  id           String             @id @default(uuid())
  submissionId String
  submission   SaleSubmission     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  order        Int
  title        String?
  // Целые единицы валюты сделки (см. комментарий секции), не центы.
  amount       Float
  // Срок оплаты. Хранится в UTC; вычисляется от SaleSubmission.createdAt
  // + offsetDays шаблона через common/tj-time.ts, а не сырой арифметикой.
  dueDate      DateTime
  status       PaymentStageStatus @default(PENDING)
  paidAt       DateTime?
  // Платёж, который погасил этап. SetNull, а не Cascade: удаление одного
  // платежа не должно сносить сам этап рассрочки — он вернётся в
  // PENDING/OVERDUE и его снова можно будет закрыть.
  paymentId    String?
  payment      SubmissionPayment? @relation("PaymentStageSettledBy", fields: [paymentId], references: [id], onDelete: SetNull)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([submissionId, order])
  // Выборка суточного cron'а просрочки: PENDING с dueDate < начала суток.
  @@index([status, dueDate])
  @@index([dueDate])
  @@index([paymentId])
}
