# PostgreSQL
DATABASE_URL="postgresql://javonon:javonon@localhost:5432/javonon?schema=public"

# Server
PORT=3001

# JWT — для сотрудников CRM
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Отдельный JWT для студентов (опционально). Если не задан — используется JWT_SECRET (legacy fallback).
# Рекомендуется: задать длинную случайную строку, отличную от JWT_SECRET.
STUDENT_JWT_SECRET=""

# CORS — список фронтендов через запятую
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# Загрузка файлов
UPLOADS_DIR="./uploads"
MAX_FILE_SIZE=209715200

# Telegram бот (опционально). Получить токен у @BotFather.
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_CHAT_ID — личный чат / группа администраторов, куда бот шлёт
# уведомления о новых заявках с лендинга. ID можно узнать у @userinfobot.
TELEGRAM_CHAT_ID=""

# TELEGRAM_CHANNEL_ID — публичный канал, куда бот автоматически постит
# карточки программ. Бот должен быть админом канала.
# Формат: "@javonon_channel" или числовой ID -100xxxx.
TELEGRAM_CHANNEL_ID=""

# PUBLIC_API_BASE — внешний URL бэкенда, нужен Telegram-каналу чтобы
# подгрузить картинку программы (например https://javonon-production.up.railway.app)
PUBLIC_API_BASE=""

# SMTP для email-уведомлений (опционально)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Javonon <noreply@javonon.local>"
ADMIN_EMAIL=""

# SMS-уведомления (опционально). SMS_PROVIDER = "payom" | "smsru" | "twilio" | пусто (отключено)
SMS_PROVIDER=""

# Payom.tj — таджикский SMS-шлюз. https://payom.tj/
PAYOM_API_URL="https://gateway.payom.tj"
PAYOM_TOKEN=""
PAYOM_SENDER=""

# SMS.ru — глобальный провайдер для RU/CIS. https://sms.ru → Settings → API → API ID
SMSRU_API_ID=""
SMS_FROM=""

# Twilio — глобальный провайдер. https://console.twilio.com
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# URL студенческого ЛК — используется в письмах "забыли пароль".
STUDENT_LOGIN_URL=""

# --- Sprint F: Внешние интеграции (каркас) ---

# WhatsApp Business Cloud API (Meta).
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""

# Instagram Messaging (Meta Graph API).
IG_PAGE_ACCESS_TOKEN=""
IG_ACCOUNT_ID=""
IG_VERIFY_TOKEN=""

# Twilio Voice (звонки из CRM через WebRTC).
# TWILIO_ACCOUNT_SID уже задан выше (для SMS).
TWILIO_API_KEY_SID=""
TWILIO_API_KEY_SECRET=""
TWILIO_TWIML_APP_SID=""
TWILIO_CALLER_ID=""
